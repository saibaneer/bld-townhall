# Copy this file to `.env` (which is gitignored) and fill in real values.
# NEVER commit `.env`; NEVER paste these secrets into a shell command,
# a URL, or a chat — the code reads them from the environment at runtime.

# --- Stripe (M10 payment handoff) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Twilio (M12 real SMS adapter) ---
# Two credential shapes are supported. Twilio's REST URL always carries the
# ACCOUNT SID (AC…); the basic-auth USERNAME is either that same AC… (Auth-Token
# auth) or a separate API Key SID (SK…). They are different values — putting an
# SK… where the AC… belongs is a 401 "no requested permission".
#
# TWILIO_SID: the basic-auth username. An API Key SID (SK…, recommended: scoped
# and revocable) or the Account SID (AC…) if you use the Auth Token directly.
TWILIO_SID=SK...
# TWILIO_CLIENT_SECRET: SECRET — the API Key Secret, or the Account Auth Token.
TWILIO_CLIENT_SECRET=...
# TWILIO_ACCOUNT_SID: the AC… Account SID for the URL path. REQUIRED when
# TWILIO_SID is an SK… key; OPTIONAL (falls back to TWILIO_SID) when TWILIO_SID is
# itself the AC… Account SID.
TWILIO_ACCOUNT_SID=AC...
# A SENDER for each channel you use — both optional; configure whichever you need.
# SMS sender: an SMS-capable Twilio number in E.164 (needs a per-country number,
# and UK numbers need a regulatory bundle; US numbers can't SMS the UK).
TWILIO_FROM_NUMBER=+1...
# WhatsApp sender in E.164, carried as whatsapp:<number>. The Sandbox number
# (Console → Messaging → Try it out → Send a WhatsApp message) is usually
# +14155238886. WhatsApp needs no per-country number/bundle — it reaches any
# recipient who has JOINED the sandbox (send its `join <code>` from WhatsApp).
TWILIO_WHATSAPP_FROM=+14155238886
# ONLY for the opt-in `twilio-live` test lane: your recipient number (verified for
# SMS, or joined to the WhatsApp sandbox). Not needed at runtime.
TWILIO_TEST_TO=+44...
#
# NOTE: inbound webhook verification (X-Twilio-Signature, M12 increment 2) is
# signed with the ACCOUNT AUTH TOKEN specifically — not an API Key Secret — so
# that path will need the Auth Token available too.
