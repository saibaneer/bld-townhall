# Copy this file to `.env` (which is gitignored) and fill in real values.
# NEVER commit `.env`; NEVER paste these secrets into a shell command,
# a URL, or a chat — the code reads them from the environment at runtime.

# --- Stripe (M10 payment handoff) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Twilio (M12 real SMS adapter) ---
# Account SID: an identifier (appears in API URLs) — not a secret.
TWILIO_SID=AC...
# The Auth Token: SECRET. Authenticates outbound sends AND is the key Twilio
# signs inbound webhooks with (X-Twilio-Signature), so we verify inbound with it
# too. If this value ever leaves `.env`, rotate it in the Twilio console.
TWILIO_CLIENT_SECRET=...
# The SMS-capable Twilio number we send FROM, in E.164 (e.g. +447723317807).
TWILIO_FROM_NUMBER=+44...
# ONLY for the opt-in `twilio-live` test lane: your verified recipient number.
# A trial account can text only verified numbers. Not needed at runtime.
TWILIO_TEST_TO=+44...
